{
  "name": "min-books-internal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -v && npm -v && next --version && next typegen && npm run typecheck && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/prepare-pdf-font.mjs",
    "test:ledger": "node --test scripts/test-ledger.mjs",
    "test:calculations": "node --test scripts/test-calculations.mjs",
    "test:india-tax": "node --test scripts/test-india-tax.mjs",
    "test:all": "npm run test:calculations && npm run test:ledger && npm run test:india-tax"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.48.0",
    "geist": "1.7.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "24.x"
  }
}
